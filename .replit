modules = ["nodejs-20", "web", "bash", "postgresql-16", "python-base-3.13"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "i18n"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Polar sandbox forwarding"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "i18n"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:i18n"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "Polar sandbox forwarding"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run polar:sandbox:forward"

[workflows.workflow.metadata]
outputType = "console"

[agent]
integrations = ["javascript_openai_ai_integrations:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_database:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.shared]
APP_OWNER_EMAIL = "teamgog3@gmail.com"

[userenv.development]
GOOGLE_CALLBACK_URL = "https://15526b3e-3811-4355-973d-309a56f0784d-00-1gkt2hqs9ng5q.reed.replit.dev/api/auth/google/callback"
POLAR_QUARTERLY_PRODUCT_ID = "4bd41aa7-e4e6-4ef7-abe1-5880d3dc9b79"
POLAR_SEMIANNUAL_PRODUCT_ID = "3937794a-70b5-4d8c-a760-855dda4df760"

[userenv.production]
GOOGLE_CALLBACK_URL = "https://swahilimentorai-1.replit.app/api/auth/google/callback"
POLAR_QUARTERLY_PRODUCT_ID = "5c44e4fa-917d-4756-b9b4-b3d3bc458333"
POLAR_SEMIANNUAL_PRODUCT_ID = "f217f76a-88c7-4c0b-b8b2-8ff89820f712"
